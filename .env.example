# Valeur par défaut : aucune photographie tierce chargée.
# Mettre true uniquement après autorisation de leur affichage distant.
PUBLIC_USE_OFFICIAL_MEDIA=false
# URL publique connue, utilisée par défaut pour Open Graph et les canonical.
# Modifier seulement si le domaine de présentation change.
PUBLIC_SITE_URL=https://concept-standard.vercel.app
