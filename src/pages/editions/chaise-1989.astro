---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Media from '../../components/Media.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import Facts from '../../components/Facts.astro';
import Gallery from '../../components/Gallery.astro';
import UniverseLink from '../../components/UniverseLink.astro';
import Lightbox from '../../components/Lightbox.astro';
import Icon from '../../components/Icon.astro';
import { media, useOfficialMedia } from '../../data/media';
import { official, chairFacts } from '../../data/site';
import '../../styles/detail.css';
---
<BaseLayout title="Chaise 1989 / Nouveau Standard" description="Chaise 1989 de Nouveau Standard : inox, inox miroir et satin de laine. Concept indépendant et non officiel de galerie éditoriale par Devzair." current="editions">
  <section class="object-hero container" aria-labelledby="chair-title">
    <div class="detail-topline micro"><a href="/">Accueil /</a><span>Nouveau Standard · Éditions</span><span>Collection / 1989</span></div>
    <div class="object-hero-grid"><div class="object-hero-copy"><span class="micro">Collection 1989 / Assise</span><h1 id="chair-title">Chaise<br /><span class="outline">1989.</span></h1><div><p class="copy">La mémoire des formes.<br />L’audace du présent.<br />Une pièce envisagée comme un objet de collection.</p><a class="text-link" href="#galerie">Regarder la pièce <Icon name="down" /></a></div></div><Media class="object-hero-art" item={media.chair} priority zoom /></div>
    <div class="object-hero-foot micro"><span>Métal & textile / La rencontre des matières</span><span>Une édition Nouveau Standard</span></div>
  </section>

  <section class="object-thesis section-space container" aria-labelledby="object-thesis-title"><SectionLabel index="01" label="L’objet" aside="Une pièce, une histoire" /><h2 class="display" id="object-thesis-title">L’objet.<br />Le <span class="blue">geste.</span><br />Le temps.</h2><div class="statement-bottom"><span class="micro">1989 / Souvenirs réinterprétés</span><p class="copy">Les intérieurs de la fin des années 1980 nourrissent cette collection. Le métal et le textile deviennent le point de rencontre entre une mémoire familière et une écriture contemporaine.</p></div></section>

  <section class="object-gallery section-space" id="galerie" aria-labelledby="gallery-title"><div class="container"><SectionLabel index="02" label="Regards sur la pièce" aside="Galerie / 3 regards" /><div class="section-heading"><h2 class="display" id="gallery-title">La pièce<br />en images.</h2><div class="copy"><p>Sélectionner un regard.<br />S’arrêter sur une forme.<br />Agrandir pour prendre le temps.</p>{!useOfficialMedia && <p class="editorial-note">Illustrations d’intention : les photographies officielles seront affichées après autorisation.</p>}</div></div><Gallery /></div></section>

  <section class="object-specs section-space" id="matieres" aria-labelledby="specs-title"><div class="container"><SectionLabel index="03" label="La matière & les mesures" aside="Notice de galerie" /><div class="section-heading"><h2 class="display" id="specs-title">La beauté<br />du <span>détail.</span></h2><p class="copy">La précision du métal, la présence du textile. Des associations de matières au service de la silhouette.</p></div><div class="specs-layout"><figure class="material-study"><div class="swatch swatch-steel"><span class="micro">01 / Inox</span></div><div class="swatch swatch-mirror"><span class="micro">02 / Inox miroir</span></div><div class="swatch swatch-textile"><span class="micro">03 / Satin de laine</span></div><figcaption class="micro">Évocations graphiques / Matières non contractuelles</figcaption></figure><div><Facts items={chairFacts} /><p class="specs-note">Dimensions et matériaux repris du catalogue officiel. Pour toute demande sur cette pièce, adressez-vous au studio.</p><ExternalLink href={official.nouveau}>Consulter le catalogue officiel</ExternalLink></div></div></div></section>

  <section class="object-craft section-space container" aria-labelledby="craft-title"><SectionLabel index="04" label="Gestes & mémoire" aside="Dessin / Matières / Savoir-faire" /><div class="section-heading"><h2 class="display" id="craft-title">Une pièce.<br />Un <span class="blue">langage.</span></h2><p class="copy">Nouveau Standard développe ses collections avec des artisans et manufactures. La matière, le temps de fabrication et l’attention au détail prolongent le travail du dessin.</p></div><div class="craft-grid"><figure><Media item={media.chairInterior} zoom /><figcaption class="image-caption micro">01 / L’objet dans l’espace</figcaption></figure><figure><Media item={media.collection} zoom /><figcaption class="image-caption micro">02 / Un vocabulaire commun</figcaption></figure></div><div class="craft-bottom"><span class="micro">Une édition Nouveau Standard</span><ExternalLink href={official.nouveau}>Se renseigner auprès du studio</ExternalLink></div></section>
  <UniverseLink to="architecture" />
  <Lightbox />
</BaseLayout>
